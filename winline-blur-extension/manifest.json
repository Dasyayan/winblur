{
  "manifest_version": 3,
  "name": "Winblur — Блюр рекламы Winline",
  "version": "4.0.0",
  "description": "Точно размывает только рекламу и надписи Winline на slay-award.ru. Сайт работает без изменений.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://slay-award.ru/*"],
  "content_scripts": [
    {
      "matches": ["https://slay-award.ru/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
